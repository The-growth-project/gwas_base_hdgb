import os
import math
import random


###################################################################################################
#
# This script sets up files and folders for use in other modules. 
#
# Commands to execute from the repository folder:
# conda activate snakemake
# snakemake --snakefile setup/setup.snake --cores 1 --use-conda --rerun-incomplete
#
###################################################################################################


# Genotype files
moba_base_path = '/mnt/archive/moba'
release_path = os.path.join(moba_base_path, 'geno/HDGB-MoBaGenetics/2025.09.25')
base_name = 'moba_genotypes_2025.09.25'

# Genotype files
plink_common_stem = os.path.join(release_path, f'{base_name}_common')
plink_unrelated_stem = os.path.join(release_path, f'{base_name}_unrelated_30k')
genotypes_utils_folder = os.path.join(release_path, 'utils')

# Phenotype files
unrelated_ids = os.path.join(moba_base_path, 'pheno/v12/pheno_anthropometrics_26-03-23_hdgb/id/children_id_ceu_unrelated_plink')
unrelated_ids_30k = os.path.join(moba_base_path, 'pheno/v12/pheno_anthropometrics_26-03-23_hdgb/id/children_id_ceu_unrelated_30k_plink')



####################### Housekeeping #########################################

if not os.path.isdir(genotypes_utils_folder):
    os.makedirs(genotypes_utils_folder)


############################## RULES ###########################################


print(f'Setting up files for release {base_name}')
rule all:
    'The files expected to be created'
    input:
        plink_release_pgenset = multiext(plink_unrelated_stem, ".bed", ".bim", ".fam"),
        freq_file = os.path.join(genotypes_utils_folder, "moba_genotypes_2025.09.25_common_ceu.afreq")


rule moba_freq:
    'Computes allele frequencies'
    input:
        plink_release_pgenset = multiext(plink_common_stem, ".bed", ".bim", ".fam"),
        ids = unrelated_ids
    params:
        genotypes = plink_common_stem,
        utils_stem = os.path.join(genotypes_utils_folder, "moba_genotypes_2025.09.25_common")
    output:
        freq_file = os.path.join(genotypes_utils_folder, "moba_genotypes_2025.09.25_common_ceu.afreq")
    conda:
        "envs/plink_2.yaml"
    threads: 1
    shell:
        """
        plink2 -bfile {params.genotypes} --keep {input.ids} --freq --out {params.utils_stem}
        """

rule moba_independent:
    'Writes a plink files with 30k unrelated kids'
    input:
        plink_release_pgenset = multiext(plink_common_stem, ".bed", ".bim", ".fam"),
        ids = unrelated_ids_30k
    params:
        genotypes = plink_common_stem,
        genotypes_unrelated = plink_unrelated_stem
    output:
        plink_release_pgenset = multiext(plink_unrelated_stem, ".bed", ".bim", ".fam")
    conda:
        "envs/plink_2.yaml"
    threads: 1
    shell:
        """
        plink2 -bfile {params.genotypes} --keep {input.ids} --make-pgen --out {params.genotypes_unrelated}
        """
